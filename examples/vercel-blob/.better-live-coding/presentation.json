              ]
            },
            {
              "type": "insertBefore",
              "file": "src/routes/+page.svelte",
              "label": "define imageUrl state",
              "anchor": {
                "text": "  let error = $state('');"
              },
              "text": [
                "  let imageUrl = $state('');",
                ""
              ]
            }
          ]
        },
        {
          "id": "upload-button",
          "title": "Create the Upload button",
          "operations": [
            {
              "type": "replace",
              "file": "src/routes/+page.svelte",
              "label": "create the Upload button",
              "anchor": {
                "text": "  <!-- TODO: Add Upload Button -->"
              },
              "text": [
                "  <button onclick={uploadImage} disabled={!selectedFile}>",
                "    Upload",
                "  </button>"
              ]
            }
          ]
        },
        {
          "id": "upload-function",
          "title": "Implement uploadImage",
          "operations": [
            {
              "type": "insertBefore",
              "file": "src/routes/+page.svelte",
              "label": "define uploadImage function",
              "anchor": {
                "text": "</script>"
              },
              "text": [
                "",
                "  async function uploadImage() {",
                "    if (!selectedFile) return;",
                "",
                "    error = '';",
                "    imageUrl = '';",
                "",
                "    try {",
                "      const blob = await upload(`tech-share/${selectedFile.name}`, selectedFile, {",
                "        access: 'public',",
                "        handleUploadUrl: '/api/blob',",
                "        multipart: selectedFile.size > 100 * 1024 * 1024",
                "      });",
                "      ",
                "      imageUrl = blob.url;",
                "    } catch (err) {",
                "      error = err instanceof Error ? err.message : 'Upload failed';",
                "    }",
                "  }",
                ""
              ],
              "effects": {
                "suggestAfter": [
                  "blob."
                ]
              }
            }
          ]
        },
        {
          "id": "upload-backend",
          "title": "Implement the upload backend",
          "operations": [
            {
              "type": "replace",
              "file": "src/routes/api/blob/+server.ts",
              "label": "add POST endpoint imports",
              "anchor": {
                "text": "// TODO: Type Import lists."
              },
              "text": [
                "import { handleUpload, type HandleUploadBody } from '@vercel/blob/client';",
                "import type { RequestHandler } from './$types';",
                "import { BLOB_READ_WRITE_TOKEN } from '$app/env/private';"
              ]
            },
            {
              "type": "replace",
              "file": "src/routes/api/blob/+server.ts",
              "label": "define the POST upload endpoint",
              "anchor": {
                "text": "// STEP 1: Create POST\n  // TODO: Add constraints\n  // TODO: Put the file into Vercel blob using token.\n  // TODO: Return JSON Response with url and pathname."
              },
              "text": [
                "export const POST: RequestHandler = async ({ request }) => {",
                "  const body = (await request.json()) as HandleUploadBody;",
                "",
                "  try {",
                "    const jsonResponse = await handleUpload({",
                "      body,",
                "      request,",
                "      token: BLOB_READ_WRITE_TOKEN,",
                "      onBeforeGenerateToken: async (pathname) => {",
                "        if (!pathname.startsWith('tech-share/')) {",
                "          throw new Error('Invalid upload path');",
                "        }",
                "",
                "        return {",
                "          allowedContentTypes: ['image/jpeg', 'image/png', 'image/webp', 'video/mp4'],",
                "          maximumSizeInBytes: 500 * 1024 * 1024,",
                "          addRandomSuffix: true",
                "        };",
                "      }",
                "    });",
                "",
                "    return Response.json(jsonResponse);",
                "  } catch (error) {",
                "    return Response.json(",
                "      { error: error instanceof Error ? error.message : 'Upload failed' },",
                "      { status: 400 }",
                "    );",
                "  }",
                "};"
              ],
              "thinking": "Validate the upload, then let Vercel Blob issue a token",
              "effects": {
                "suggestAfter": [
                  "request.",
                  "Response."
                ],
                "parameterHintsAfter": [
                  "handleUpload("
                ]
              }
            }
          ]
        },
        {
          "id": "upload-feedback",
          "title": "Create upload feedback",
          "operations": [
            {
              "type": "replace",
              "file": "src/routes/+page.svelte",
              "label": "create the error message block",
              "anchor": {
                "text": "  <!-- TODO: Error Handling -->"
              },
              "text": [
                "  {#if error}",
                "    <p class=\"error\">{error}</p>",
                "  {/if}"
              ]
            },
            {
              "type": "delete",
              "file": "src/routes/+page.svelte",
              "label": "remove the unused message style",
              "anchor": {
                "text": "  .message {\n    color: #175cd3;\n  }\n\n"
              }
            }
          ]
        },
        {
          "id": "upload-preview",
          "title": "Create the upload preview",
          "operations": [
            {
              "type": "replace",
              "file": "src/routes/+page.svelte",
              "label": "create the upload preview block",
              "anchor": {
                "text": "  <!-- TODO: Add File Preview -->"
              },
              "text": [
                "  {#if imageUrl}",
                "    <p class=\"success\">Upload successful!</p>",
                "    <a href={imageUrl} target=\"_blank\" rel=\"noreferrer\">",
                "      Open uploaded file",
                "    </a>",
                "",
                "    {#if imageUrl.toLowerCase().endsWith('.mp4')}",
                "      <video src={imageUrl} controls preload=\"metadata\">",
                "        <track kind=\"captions\" />",
                "      </video>",
                "    {:else}",
                "      <img class=\"preview\" src={imageUrl} alt=\"Uploaded preview\" />",
