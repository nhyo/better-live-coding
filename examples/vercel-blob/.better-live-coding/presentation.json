          "operations": [
            {
              "type": "replace",
              "file": "src/routes/+page.svelte",
              "label": "create the gallery HTML",
              "anchor": {
                "text": "  <!-- TODO: Add Gallery -->\n    <!-- Gallery Loading Button -->\n    <!-- Gallery list -->"
              },
              "text": [
                "  <section>",
                "    <div class=\"section-heading\">",
                "      <div>",
                "        <p class=\"eyebrow\">Persistent storage</p>",
                "        <h2>My Gallery</h2>",
