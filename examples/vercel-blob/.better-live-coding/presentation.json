                "      {/each}",
                "    </div>",
                "  </section>"
              ]
            },
            {
              "type": "replace",
              "file": "src/routes/+page.svelte",
              "label": "extend gallery media styling to video",
              "anchor": {
                "text": "  article img {"
              },
              "text": [
                "  article img,",
                "  article video {"
              ]
            }
          ]
        },
        {
          "id": "list-function",
          "title": "Implement loadImages",
          "operations": [
            {
              "type": "insertBefore",
              "file": "src/routes/+page.svelte",
              "label": "define loadImages function",
              "anchor": {
                "text": "</script>"
              },
              "text": [
                "",
                "  async function loadImages() {",
                "    error = '';",
                "    const response = await fetch('/api/blob');",
                "",
                "    if (!response.ok) {",
                "      error = 'Failed to load images';",
                "      return;",
                "    }",
                "",
                "    images = await response.json();",
                "  }",
                ""
              ]
            }
          ]
        },
        {
          "id": "list-backend",
          "title": "Implement the gallery backend",
          "operations": [
            {
              "type": "insertBefore",
              "file": "src/routes/api/blob/+server.ts",
              "label": "import list from Vercel Blob",
              "anchor": {
                "text": "import { BLOB_READ_WRITE_TOKEN } from '$app/env/private';"
              },
              "text": [
                "import { list } from '@vercel/blob';",
                ""
              ]
            },
            {
              "type": "replace",
              "file": "src/routes/api/blob/+server.ts",
              "label": "define the GET gallery endpoint",
              "anchor": {
                "text": "// STEP 2: Create GET\n  // TODO: Get a list from Vercel Blob.\n  // TODO: Return JSON map response with url and pathname."
              },
              "text": [
                "export const GET: RequestHandler = async () => {",
                "  const { blobs } = await list({",
                "    prefix: 'tech-share/',",
                "    limit: 30,",
                "    token: BLOB_READ_WRITE_TOKEN",
                "  });",
                "",
                "  return Response.json(",
                "    blobs.map(({ url, pathname }) => ({",
                "      url,",
                "      pathname",
                "    }))",
                "  );",
                "};"
              ],
              "effects": {
                "suggestAfter": [
                  "Response."
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "delete",
