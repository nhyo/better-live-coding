    {
      "id": "upload",
      "title": "Upload with Vercel Blob",
      "objective": "Add the minimal client upload flow and its secure token endpoint.",
      "steps": [
        {
          "id": "upload-client-setup",
          "title": "Set up browser upload",
          "operations": [
            {
              "type": "insertAfter",
              "file": "src/routes/+page.svelte",
              "label": "import the browser upload helper",
              "anchor": {
                "text": "<script lang=\"ts\">"
              },
              "text": [
                "",
