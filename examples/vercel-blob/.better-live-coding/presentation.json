    {
      "id": "list",
      "title": "Load the cloud gallery",
      "objective": "Add gallery state, one loading function, one endpoint, and the gallery HTML.",
      "steps": [
        {
          "id": "list-model",
          "title": "Define the gallery model",
          "operations": [
            {
              "type": "insertBefore",
              "file": "src/routes/+page.svelte",
              "label": "define GalleryImage type",
              "anchor": {
                "text": "  let selectedFile = $state<File | null>(null);"
              },
              "text": [
                "",
                "  type GalleryImage = {",
                "    url: string;",
                "    pathname: string;",
                "  };",
                "",
                ""
              ]
            },
            {
              "type": "insertAfter",
              "file": "src/routes/+page.svelte",
              "label": "define images state",
              "anchor": {
                "text": "  let error = $state('');"
              },
              "text": [
